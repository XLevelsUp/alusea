# Copy this file to .env and fill in your own values. Never commit .env.

# Required
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ALUSEA_SUPABASE_URL=
ALUSEA_ANON_KEY=
SARVAM_API_KEY=
# Sara's voice. Without it, Sarvam's ritu speaks.
GEMINI_API_KEY=

# Leads page and Google Sheet
LEADS_PASSWORD=
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=

# Live site
COOKIE_SECURE=true
DATA_DIR=
HOST=127.0.0.1
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional
# GROQ_BACKUP_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=   (free backup model, for testing only; leave empty for real customers)
# LIMIT_HASH_SECRET=     (made automatically if empty; required with DATABASE_URL)
# CHAT_RETENTION_DAYS=90
# MAX_VOICE_CACHE_MB=500
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
# LIMIT_CALL_VISITOR=3  (any LIMIT_<USE>_<VISITOR|IP|SITE> setting)
# EXTRA_FRAME_ORIGINS=http://localhost:3000  (other sites allowed to show Sara in a frame, for testing the alusea.in chat panel locally)

# Vercel (see docs/deployment.md). Without DATABASE_URL, chats and leads are kept in chat.db in DATA_DIR.
# DATABASE_URL=postgresql://...   (Supabase > Connect > Transaction pooler, port 6543)
# CRON_SECRET=                    (a long random value; Vercel sends it to /cron/daily)
