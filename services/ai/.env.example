# Copy this file to .env and fill in your own values. Never commit .env.

# Required
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ALUSEA_SUPABASE_URL=
ALUSEA_ANON_KEY=
SARVAM_API_KEY=

# Leads page and Google Sheet
LEADS_PASSWORD=
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=

# Live site
COOKIE_SECURE=true
DATA_DIR=
HOST=127.0.0.1
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional
# GROQ_BACKUP_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=   (free backup model, for testing only; leave empty for real customers)
# LIMIT_HASH_SECRET=     (made automatically if empty)
# CHAT_RETENTION_DAYS=90
# MAX_VOICE_CACHE_MB=500
# LIMIT_CALL_VISITOR=3  (any LIMIT_<USE>_<VISITOR|IP|SITE> setting)
