NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Apps Script Web App URL (contact form -> Google Sheets)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=your_google_apps_script_url

# Meta WhatsApp Cloud API (contact form -> WhatsApp notification)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_RECIPIENT_NUMBER=your_whatsapp_recipient_number
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_TEMPLATE_NAME=your_whatsapp_template_name

# Instagram Feed (Instagram API with Instagram Login)
# NOTE: paste the LONG-LIVED token here, not the short-lived one.
# 1) Exchange your short-lived token for a long-lived one (valid 60 days):
#    curl "https://graph.instagram.com/access_token?grant_type=ig_exchange_token&client_secret=YOUR_APP_SECRET&access_token=YOUR_SHORT_LIVED_TOKEN"
# 2) Refresh it before it expires (any time after 24h, resets to 60 days):
#    curl "https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=YOUR_LONG_LIVED_TOKEN"
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token

# Microsoft Clarity (heatmaps/session recording)
# Find your Project ID at https://clarity.microsoft.com -> Settings -> Setup
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Meta Pixel ID (falls back to a hardcoded default in src/lib/fpixel.ts if unset)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
