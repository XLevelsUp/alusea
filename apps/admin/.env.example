NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# The live marketing site's URL — used to build "View live post" links
# from the blog admin. Point this at your local marketing dev server
# during development (e.g. http://localhost:3000).
NEXT_PUBLIC_MARKETING_URL=https://www.alusea.in

# Meta Commerce Catalog (WhatsApp product catalog sync)
# Catalog ID: from business.facebook.com/commerce -> your catalog -> Settings
# Access token: a long-lived USER token (60 days) with the catalog_management
# scope, generated via Graph API Explorer then extended at
# https://developers.facebook.com/tools/debug/accesstoken/ ("Extend Access Token").
# It must be renewed before it expires or catalog syncing will silently fail.
META_CATALOG_ID=your_meta_catalog_id
META_CATALOG_ACCESS_TOKEN=your_long_lived_catalog_access_token

# Public site URL used for product images and links sent to Meta. Always the
# production domain, even in development — Meta fetches these from its own
# servers and rejects localhost URLs. Keep this separate from
# NEXT_PUBLIC_MARKETING_URL, which may point at a local dev server.
META_PUBLIC_SITE_URL=https://www.alusea.in
